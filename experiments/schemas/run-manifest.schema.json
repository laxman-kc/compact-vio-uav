{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/laxman-kc/compact-vio-uav/experiments/schemas/run-manifest.schema.json",
  "title": "compact-vio-uav run manifest",
  "description": "Immutable pre-export provenance and artifact-identity record for a planned, completed, failed, or aborted experiment. Post-export locations and verification belong in an artifact-storage-evidence sidecar. Secrets must not appear in any field.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "status",
    "purpose",
    "provenance",
    "experiment",
    "data",
    "evaluation",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "finished_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "status": {
      "enum": ["planned", "running", "succeeded", "failed", "aborted"]
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "protocol_revision": {
      "type": "string",
      "description": "Immutable protocol identifier or Git path plus revision."
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "experiment": {
      "$ref": "#/$defs/experiment"
    },
    "data": {
      "$ref": "#/$defs/data"
    },
    "evaluation": {
      "$ref": "#/$defs/evaluation"
    },
    "artifacts": {
      "type": "array",
      "uniqueItems": true,
      "$comment": "Semantic validation must also reject repeated artifact_id or path values when the remaining fields differ.",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "outcome": {
      "$ref": "#/$defs/outcome"
    },
    "protocol_deviations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": ["succeeded", "failed", "aborted"]
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["started_at", "finished_at", "outcome"],
        "properties": {
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "finished_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "canonical_relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*/$).+$"
    },
    "credential_free_uri_reference": {
      "type": "string",
      "format": "uri-reference",
      "pattern": "^(?!.*[?#@])(?!.*%(?:23|25|3[fF]|40)).+$",
      "description": "Non-empty credential-free reference without raw or encoded userinfo, query, or fragment delimiters."
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "kind",
        "retention_class",
        "rights_lane",
        "path",
        "byte_size",
        "sha256"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
        },
        "kind": {
          "enum": [
            "checkpoint",
            "resume_checkpoint",
            "trajectory",
            "metrics",
            "log",
            "report",
            "profile",
            "onnx",
            "runtime_engine",
            "calibration",
            "configuration",
            "environment",
            "other"
          ]
        },
        "retention_class": {
          "enum": ["reproducibility_critical", "resume_only", "diagnostic", "disposable", "release"]
        },
        "rights_lane": {
          "enum": ["unresolved", "research_only", "commercially_eligible", "internal_only", "public_release"]
        },
        "path": {
          "$ref": "#/$defs/canonical_relative_path",
          "description": "Stable path within the portable run bundle."
        },
        "media_type": {
          "type": "string"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "expires_at": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit_sha", "dirty"],
      "properties": {
        "repository": {
          "$ref": "#/$defs/credential_free_uri_reference"
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "branch": {
          "type": ["string", "null"]
        },
        "dirty": {
          "type": "boolean"
        },
        "diff_sha256": {
          "anyOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ],
          "description": "Required by project policy for a dirty diagnostic run; claim-supporting runs must be clean."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "dirty": {
                "const": true
              }
            },
            "required": ["dirty"]
          },
          "then": {
            "required": ["diff_sha256"],
            "properties": {
              "diff_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      ]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "fingerprint"],
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1,
          "description": "Immutable environment identifier, such as lockfile hash or image digest."
        },
        "container_digest": {
          "type": ["string", "null"]
        },
        "runtime_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform_role", "summary"],
      "properties": {
        "platform_role": {
          "enum": ["local_development", "training_worker", "evaluation_worker", "edge_target", "simulation", "other"]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "cpu": {
          "type": ["string", "null"]
        },
        "gpu": {
          "type": ["string", "null"]
        },
        "memory_bytes": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "driver": {
          "type": ["string", "null"]
        },
        "power_mode": {
          "type": ["string", "null"]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git", "environment", "hardware"],
      "properties": {
        "git": {
          "$ref": "#/$defs/git"
        },
        "environment": {
          "$ref": "#/$defs/environment"
        },
        "hardware": {
          "$ref": "#/$defs/hardware"
        }
      }
    },
    "configuration_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "$ref": "#/$defs/canonical_relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_family", "candidate_name", "configuration", "seeds"],
      "properties": {
        "hypothesis_id": {
          "type": ["string", "null"]
        },
        "candidate_family": {
          "enum": ["classical", "hybrid", "end_to_end_learned", "diagnostic", "export", "integration", "other"]
        },
        "candidate_name": {
          "type": "string",
          "minLength": 1
        },
        "candidate_version": {
          "type": ["string", "null"]
        },
        "configuration": {
          "$ref": "#/$defs/configuration_reference"
        },
        "seeds": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "uniqueItems": true
        },
        "parent_run_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "split_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "manifest_path", "manifest_sha256", "source_group_policy"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": ["train", "validation", "test", "stress", "calibration", "other"]
        },
        "manifest_path": {
          "$ref": "#/$defs/canonical_relative_path"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_group_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dataset_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "registry_revision", "acquisition_manifest", "splits"],
      "properties": {
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "dataset_version": {
          "type": ["string", "null"]
        },
        "registry_revision": {
          "type": "string",
          "minLength": 1
        },
        "acquisition_manifest": {
          "$ref": "#/$defs/configuration_reference"
        },
        "splits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/split_reference"
          }
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datasets"],
      "properties": {
        "datasets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dataset_reference"
          }
        },
        "preprocessing": {
          "anyOf": [
            { "$ref": "#/$defs/configuration_reference" },
            { "type": "null" }
          ]
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configuration", "metric_scale_claim", "primary_alignment", "causal"],
      "properties": {
        "configuration": {
          "$ref": "#/$defs/configuration_reference"
        },
        "metric_scale_claim": {
          "type": "boolean"
        },
        "primary_alignment": {
          "enum": ["none", "translation", "yaw_translation", "se3", "sim3", "other"]
        },
        "causal": {
          "type": "boolean"
        },
        "metrics_artifact_id": {
          "type": ["string", "null"]
        },
        "coverage_artifact_id": {
          "type": ["string", "null"]
        },
        "runtime_profile_artifact_id": {
          "type": ["string", "null"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "metric_scale_claim": {
                "const": true
              }
            },
            "required": ["metric_scale_claim"]
          },
          "then": {
            "properties": {
              "primary_alignment": {
                "not": {
                  "const": "sim3"
                }
              }
            }
          }
        }
      ]
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "exit_code": {
          "type": ["integer", "null"]
        },
        "failure_category": {
          "enum": ["none", "data", "environment", "implementation", "resource", "estimator", "protocol", "external", "unknown"]
        }
      }
    }
  }
}
