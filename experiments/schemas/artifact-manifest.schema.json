{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/laxman-kc/compact-vio-uav/experiments/schemas/artifact-manifest.schema.json",
  "title": "compact-vio-uav artifact bundle inventory",
  "description": "Canonical file identity manifest written by compact_vio.artifacts. File records must also be sorted lexically by path; ordering is enforced by the implementation because JSON Schema cannot express it portably.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "hash_algorithm",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "hash_algorithm": {
      "const": "sha256"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      }
    }
  },
  "$defs": {
    "canonical_relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*/$).+$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
      "path": {
        "allOf": [
          { "$ref": "#/$defs/canonical_relative_path" },
          { "not": { "const": "artifact-manifest.json" } }
        ],
        "description": "Payload path. artifact-manifest.json is self-excluded and must never appear in its own file inventory."
      },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
